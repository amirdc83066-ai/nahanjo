     <property name="styleSheet">
      <string notr="true">QMainWindow{
    background:qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #eef2f7,
        stop:1 #d9e4f5
    );
}

/* عنوان */
#lbl_title{
    color:#2b3c4e;
    font-family:&quot;Segoe UI Semibold&quot;;
    font-size:32pt;
    font-weight:700;
    padding:10px;
    letter-spacing:1px;
}

/* زیرعنوان */
#lbl_subtitle{
    color:#5c6979;
    font-family:&quot;Segoe UI&quot;;
    font-size:12pt;
    padding-bottom:12px;
}

/* کارت متن معرفی */
#txt_intro{
    background:white;
    border-radius:18px;
    border:1px solid #e0e6ed;
    padding:22px;
    font-size:11.3pt;
    color:#2f3640;
    font-family:&quot;Segoe UI&quot;;
}

/* سایه بصری کارت */
#txt_intro{
    box-shadow: 0px 4px 12px rgba(0,0,0,0.08);
}

/* اسکرول بار حرفه‌ای */
QTextBrowser QScrollBar:vertical{
    width:10px;
    background:transparent;
}

QTextBrowser QScrollBar::handle:vertical{
    background:#c8d2de;
    border-radius:5px;
}

QTextBrowser QScrollBar::handle:vertical:hover{
    background:#aeb9c6;
}

/* دکمه اصلی */
#btn_next{
    background:qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #4facfe,
        stop:1 #00c6ff
    );
    color:white;
    border-radius:12px;
    font-weight:600;
    font-size:12pt;
    padding:10px 22px;
}

/* Hover */
#btn_start:hover{
    background:qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #3d8ef7,
        stop:1 #00aaff
    );
}

/* وقتی کلیک شد */
#btn_start:pressed{
    background:#005fb8;
}

/* دکمه خروج */
#btn_exit{
    background:#f2f4f7;
    color:#2c3e50;
    border-radius:10px;
    font-weight:600;
    font-size:11pt;
    padding:8px 18px;
    border:1px solid #d9dee4;
}

#btn_exit:hover{
    background:#e0e4e8;
}

#btn_exit:pressed{
    background:#c7ccd1;
}
</string>
