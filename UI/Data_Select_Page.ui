  <property name="styleSheet">
   <string notr="true">QWidget#data_select_page{
    background:qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:1,
        stop:0 #eef2f7,
        stop:1 #d9e4f5
    );
}

/* عنوان (در این صفحه label همان drop zone است) */
QLabel#drop_label{
    background:#d1d5db;
    border:2px dashed #9ca3af;
    border-radius:16px;
    color:#374151;
    font-family:&quot;Segoe UI&quot;;
    font-size:11pt;
}

QPushButton {
    background-color: #e53935;
    color: white;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 11pt;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #ef5350;
}

QPushButton:pressed {
    background-color: #c62828;
}

/* دکمه بازگشت */
QPushButton#btn_back{
    background:#f2f4f7;
    color:#2c3e50;
    border-radius:10px;
    font-weight:600;
    font-size:11pt;
    padding:8px 18px;
    border:1px solid #d9dee4;
}

QPushButton#btn_back:hover{
    background:#e0e4e8;
}

QPushButton#btn_back:pressed{
    background:#c7ccd1;
}

/* جدول پیش‌نمایش */
QTableView#table_preview{
    background:white;
    border:1px solid #e0e6ed;
    gridline-color:#d0d7e2;
    font-family:&quot;Segoe UI&quot;;
    font-size:10.5pt;
    color:#2f3640;
    selection-background-color:#4facfe;
    selection-color:white;
    alternate-background-color:#f9fafb;
}

/* دکمه شروع تحلیل */
QPushButton#btn_start{
    background:qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #4facfe,
        stop:1 #00c6ff
    );
    color:white;
    border:none;
    border-radius:12px;
    font-weight:600;
    font-size:12pt;
    padding:10px 22px;
}

QPushButton#pushButton:hover{
    background:qlineargradient(
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #3d8ef7,
        stop:1 #00aaff
    );
}

QPushButton#pushButton:pressed{
    background:#005fb8;
}
</string>
