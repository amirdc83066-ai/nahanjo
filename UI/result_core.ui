   <string notr="true">/* پس‌زمینه صفحه */ QWidget#ResultPage { background:qlineargradient( spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #eef2f7, stop:1 #d9e4f5 ); } /* عنوان اصلی صفحه */ QLabel#label_title { color:#374151; font-family:&quot;Segoe UI&quot;; font-size:18pt; font-weight:bold; padding:8px; } /* دکمه‌های عمومی */ QPushButton { background-color: #e53935; color: white; border-radius: 8px; padding: 8px 16px; font-size: 11pt; font-weight: bold; } QPushButton:hover { background-color: #ef5350; } QPushButton:pressed { background-color: #c62828; } /* دکمه بازگشت */ QPushButton#btn_back { background:#f2f4f7; color:#2c3e50; border-radius:10px; font-weight:600; font-size:11pt; padding:8px 18px; border:1px solid #d9dee4; } QPushButton#btn_back:hover { background:#e0e4e8; } QPushButton#btn_back:pressed { background:#c7ccd1; } /* دکمه ذخیره نتایج */ QPushButton#btn_save { background:qlineargradient( x1:0, y1:0, x2:1, y2:0, stop:0 #4facfe, stop:1 #00c6ff ); color:white; border:none; border-radius:12px; font-weight:600; font-size:11pt; padding:8px 20px; } QPushButton#btn_save:hover { background:qlineargradient( x1:0, y1:0, x2:1, y2:0, stop:0 #3d8ef7, stop:1 #00aaff ); } QPushButton#btn_save:pressed { background:#005fb8; } /* دکمه تحلیل با هوش مصنوعی */ QPushButton#btn_ai { background:qlineargradient( x1:0, y1:0, x2:1, y2:0, stop:0 #4facfe, stop:1 #00c6ff ); color:white; border:none; border-radius:12px; font-weight:600; font-size:11pt; padding:8px 20px; } QPushButton#btn_ai:hover { background:qlineargradient( x1:0, y1:0, x2:1, y2:0, stop:0 #3d8ef7, stop:1 #00aaff ); } QPushButton#btn_ai:pressed { background:#005fb8; } /* جدول اصلی نتایج */ QTableView#table_results { background:white; border:1px solid #e0e6ed; gridline-color:#d0d7e2; font-family:&quot;Segoe UI&quot;; font-size:10.5pt; color:#2f3640; selection-background-color:#4facfe; selection-color:white; alternate-background-color:#f9fafb; } </string>
